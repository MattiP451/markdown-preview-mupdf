diff --git a/build/mdpreview.m4 b/build/mdpreview.m4
new file mode 100644
index 0000000..59995a8
--- /dev/null
+++ b/build/mdpreview.m4
@@ -0,0 +1,53 @@
+dnl GP_CHECK_MDPREVIEW
+dnl Markdown preview rendered with MuPDF. MuPDF is rarely packaged as a
+dnl shared library, so point configure at a MuPDF source tree that has
+dnl been built with "make libs":  --with-mupdf=/path/to/mupdf
+AC_DEFUN([GP_CHECK_MDPREVIEW],
+[
+    GP_ARG_DISABLE([MDPreview], [auto])
+
+    AC_ARG_WITH([mupdf],
+        AS_HELP_STRING([--with-mupdf=DIR],
+            [MuPDF source tree built with "make libs", for the MDPreview plugin]),
+        [mupdf_dir=$withval],
+        [mupdf_dir=no])
+    AC_ARG_VAR([MUPDF_LIBDIR],
+        [Directory with libmupdf.a and libmupdf-third.a (default: DIR/build/release)])
+
+    MUPDF_CFLAGS=
+    MUPDF_LIBS=
+    if test "x$enable_mdpreview" != xno; then
+        if test "x$mupdf_dir" = xno || test "x$mupdf_dir" = xyes; then
+            AS_IF([test "x$enable_mdpreview" = xyes],
+                  [AC_MSG_ERROR([The MDPreview plugin needs --with-mupdf=DIR])])
+            enable_mdpreview=no
+        else
+            mupdf_dir=`cd "$mupdf_dir" 2>/dev/null && pwd`
+            test -n "$MUPDF_LIBDIR" || MUPDF_LIBDIR="$mupdf_dir/build/release"
+            AC_MSG_CHECKING([for a built MuPDF in $mupdf_dir])
+            if test -n "$mupdf_dir" &&
+               test -f "$mupdf_dir/include/mupdf/fitz.h" &&
+               test -f "$MUPDF_LIBDIR/libmupdf.a" &&
+               test -f "$MUPDF_LIBDIR/libmupdf-third.a"; then
+                AC_MSG_RESULT([yes])
+                MUPDF_CFLAGS="-I$mupdf_dir/include"
+                MUPDF_LIBS="$MUPDF_LIBDIR/libmupdf.a $MUPDF_LIBDIR/libmupdf-third.a -lm -lpthread"
+            else
+                AC_MSG_RESULT([no])
+                AS_IF([test "x$enable_mdpreview" = xyes],
+                      [AC_MSG_ERROR([MuPDF headers or libraries not found (build MuPDF with "make libs" first)])],
+                      [AC_MSG_WARN([MuPDF not found, disabling the MDPreview plugin])
+                       enable_mdpreview=no])
+            fi
+        fi
+    fi
+    AC_SUBST([MUPDF_CFLAGS])
+    AC_SUBST([MUPDF_LIBS])
+
+    GP_COMMIT_PLUGIN_STATUS([MDPreview])
+
+    AC_CONFIG_FILES([
+        mdpreview/Makefile
+        mdpreview/src/Makefile
+    ])
+])
