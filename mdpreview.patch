diff --git a/mdpreview/Makefile.standalone b/mdpreview/Makefile.standalone
new file mode 100644
index 0000000..0944b1b
--- /dev/null
+++ b/mdpreview/Makefile.standalone
@@ -0,0 +1,39 @@
+# Build the plugin on its own, against the installed Geany and a MuPDF
+# source tree that has been built with:
+#
+#   make HAVE_X11=no HAVE_GLUT=no HAVE_CURL=no XCFLAGS="-fPIC -DTOFU -DTOFU_CJK" libs
+#
+# Usage:
+#   make -f Makefile.standalone MUPDF=/path/to/mupdf
+#   make -f Makefile.standalone MUPDF=/path/to/mupdf install   # into ~/.config/geany/plugins
+
+MUPDF     ?= /tmp/mupdf
+MUPDF_LIB ?= $(MUPDF)/build/release
+PLUGINDIR ?= $(HOME)/.config/geany/plugins
+
+CC      ?= cc
+CFLAGS  ?= -O2 -g -Wall
+PKGS     = geany gtk+-3.0
+
+PKG_CFLAGS := $(shell pkg-config --cflags $(PKGS))
+PKG_LIBS   := $(shell pkg-config --libs $(PKGS))
+
+mdpreview.so: src/mdpreview.c
+	@test -f $(MUPDF_LIB)/libmupdf.a || { echo "*** $(MUPDF_LIB)/libmupdf.a not found - build MuPDF first, or set MUPDF=..."; exit 1; }
+	$(CC) $(CFLAGS) -fPIC -shared -o $@ $< \
+		$(PKG_CFLAGS) -I$(MUPDF)/include \
+		$(MUPDF_LIB)/libmupdf.a $(MUPDF_LIB)/libmupdf-third.a \
+		$(PKG_LIBS) -lm -lpthread \
+		-Wl,--exclude-libs,ALL -Wl,-z,defs
+
+install: mdpreview.so
+	mkdir -p $(PLUGINDIR)
+	install -m 644 mdpreview.so $(PLUGINDIR)/mdpreview.so
+
+uninstall:
+	rm -f $(PLUGINDIR)/mdpreview.so
+
+clean:
+	rm -f mdpreview.so
+
+.PHONY: install uninstall clean
diff --git a/mdpreview/NEWS b/mdpreview/NEWS
new file mode 100644
index 0000000..fd89387
--- /dev/null
+++ b/mdpreview/NEWS
@@ -0,0 +1,24 @@
+mdpreview 0.4 (2026-10-28)
+
+ * Copying text no longer puts a line break wherever the preview wrapped
+   a line. Paragraphs, headings, list items and quotes are copied as one
+   line each, and wrapped lines in code blocks are rejoined; table cells
+   and real line breaks keep theirs.
+
+mdpreview 0.3 (2026-10-28)
+
+ * Fix the right-click menu: Copy, Select All, Copy Link Address and
+   Reload Preview did nothing.
+ * Clicking in the preview no longer scrolls it to the top.
+ * Reload Preview also re-reads the stylesheet and changed images.
+ * Licence notices for MuPDF and the libraries and data it bundles
+   (packaging/THIRD-PARTY-NOTICES.txt), included in the .deb together
+   with the AGPL-3.0 text and the source offer.
+
+mdpreview 0.2 (2026-10-28)
+
+ * Follow the desktop font DPI / text scaling (HiDPI).
+
+mdpreview 0.1 (2026-10-28)
+
+ * First release.
